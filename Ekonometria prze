# Podsumowanie modele SAR, SEM, SAC
# Funkcja wyciągająca kluczowe wyniki
extract_results <- function(model, model_name) {
  s <- summary(model)
  data.frame(
    Model = model_name,
    Zmienna = rownames(s$CoefTable),
    s$CoefTable,
    row.names = NULL
  )
}

# Tworzenie ramki danych
results <- rbind(
  extract_results(sar_panel_ek, "SAR"),
  extract_results(sem_panel_ek, "SEM"),
  extract_results(sac_panel_ek, "SAC")
)

# Wyświetlenie tabeli
print(results, digits = 3)
